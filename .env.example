# Server-only PostgreSQL connection. Use the environment-specific app login
# that inherits app_runtime; never expose this value through NEXT_PUBLIC_*.
DATABASE_URL=postgresql://<runtime-user>:<password>@<pooler-host>:6543/postgres

# Public browser/server Auth configuration. For the local stack, copy API_URL
# and PUBLISHABLE_KEY (or the legacy ANON_KEY) from `npm run auth:status`; the
# local application origin must use the literal localhost hostname so browser
# cookies and allowed origins match. These values are public; never use
# SECRET_KEY or SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<local-PUBLISHABLE_KEY-or-ANON_KEY>
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Optional browser-visible Geoapify key for explicit gym and public-place
# searches. The OpenFreeMap-backed Explore map itself requires no key. Restrict
# this public key to the approved origins for the environment and never commit
# a populated value.
NEXT_PUBLIC_GEOAPIFY_API_KEY=<restricted-public-geoapify-key>

# Notification dispatch is disabled until the migration and dedicated worker
# login are installed. Never use DATABASE_URL's ordinary app login or an owner.
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_DATABASE_URL=postgresql://<notification-worker-login>:<password>@<pooler-host>:6543/postgres
NOTIFICATION_TRANSPORT=resend
# Dedicated sending-only key restricted to movx.club; never NEXT_PUBLIC_*.
RESEND_API_KEY=<domain-restricted-sending-key>
# At least 32 random characters; Vercel supplies it as the cron bearer token.
CRON_SECRET=<random-server-only-secret>
# Local capture only: explicitly select NOTIFICATION_TRANSPORT=mailpit.
NOTIFICATION_MAILPIT_URL=http://127.0.0.1:55324
