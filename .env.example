# Server-only PostgreSQL connection. Use the environment-specific app login
# that inherits app_runtime; never expose this value through NEXT_PUBLIC_*.
DATABASE_URL=postgresql://<runtime-user>:<password>@<pooler-host>:6543/postgres

# Public browser/server Auth configuration. For the local stack, copy API_URL
# and PUBLISHABLE_KEY (or the legacy ANON_KEY) from `npm run auth:status`; the
# local application origin must use the literal localhost hostname so browser
# cookies and allowed origins match. These values are public; never use
# SECRET_KEY or SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<local-PUBLISHABLE_KEY-or-ANON_KEY>
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Browser-visible Mapbox token for the list-first Explore map and explicit
# permanent Geocoding v6 searches. Create a non-default public (`pk`) token
# with only required public scopes and URL restrictions for this environment.
# Never use a secret (`sk`) token here or commit a populated value.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=<restricted-public-pk-token>

# Marketplace chain work targets Solana Devnet and official test EURC. The
# NEXT_PUBLIC endpoint is intentionally exposed to browser code for wallet
# simulation/broadcast. SOLANA_RPC_URL is server-only and may use a credentialed
# provider URL; never copy that private URL into the NEXT_PUBLIC value.
SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_COACH_PASS_PROGRAM_ID=<deployed-devnet-coach-pass-program-address>

# Devnet-only platform payer reserved for bounded marketplace transactions. It
# pays transaction fees and rent-exempt account deposits, but never supplies
# test-EURC value or business authority. The address is public, but the base64
# value is the raw 64-byte Solana CLI keypair and must remain server-only. Use a
# dedicated test account that is separate from recovery and deployment/upgrade
# authorities; never put either setting behind NEXT_PUBLIC_* or commit a real value.
SOLANA_FEE_SPONSOR_ADDRESS=<devnet-fee-sponsor-public-address>
SOLANA_FEE_SPONSOR_KEYPAIR_BASE64=<base64-encoded-64-byte-keypair>
