{
  "name": "movx-club",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "prepare:map": "node scripts/prepare-maplibre-worker.mjs",
    "predev:local": "npm run prepare:map",
    "dev:local": "tsx scripts/start-local-development.ts",
    "predev:hosted": "npm run prepare:map",
    "dev:hosted": "node --env-file=.env.development.local scripts/start-hosted-development.mjs",
    "predev:docker": "npm run prepare:map",
    "dev:docker": "tsx scripts/start-local-development.ts",
    "predev": "npm run prepare:map",
    "dev": "tsx scripts/start-local-development.ts",
    "prebuild": "npm run prepare:map",
    "build": "next build",
    "prebuild:vercel": "npm run prepare:map",
    "build:vercel": "node scripts/validate-vercel-environment.mjs && next build",
    "start": "next start --hostname localhost --port 3100",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && tsx --conditions=react-server --test tests/server/*.test.ts",
    "test:db": "DATABASE_TEST_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres tsx --conditions=react-server --test --test-concurrency=1 tests/database/*.test.ts",
    "test:auth": "node scripts/rehearse-local-email-auth.mjs",
    "test:coach-availability": "node scripts/rehearse-local-coach-availability.mjs",
    "test:coach-availability-hosted": "node --env-file=.env.development.local scripts/rehearse-hosted-coach-availability.mjs",
    "test:coach-locations": "node scripts/rehearse-local-coach-locations.mjs",
    "test:coach-requests": "node scripts/rehearse-local-coach-booking-requests.mjs",
    "test:coach-connections": "tsx --conditions=react-server scripts/rehearse-local-coach-connections.ts",
    "test:group-discovery": "node --import tsx --conditions=react-server scripts/rehearse-local-group-discovery.ts",
    "test:coach-events-ui": "node scripts/rehearse-coach-events-ui.mjs",
    "test:coach-events-hosted": "node --env-file=.env.development.local --import tsx scripts/rehearse-hosted-coach-events.mjs",
    "test:private-messages": "node --import tsx --conditions=react-server scripts/rehearse-local-private-messages.ts",
    "test:notifications-db": "node scripts/rehearse-notifications-database.mjs",
    "test:booking-notifications-db": "node scripts/rehearse-booking-notifications-database.mjs",
    "test:notifications-ui": "node scripts/rehearse-notifications-ui.mjs",
    "test:notifications-integration": "node scripts/rehearse-notifications-integration.mjs",
    "notifications:dispatch": "node --import tsx --conditions=react-server scripts/dispatch-notifications.ts",
    "test:athlete-connections": "tsx --conditions=react-server scripts/rehearse-local-athlete-connections.ts",
    "test:client-requests": "node scripts/rehearse-local-client-booking-requests.mjs",
    "test:profile-images": "node scripts/rehearse-local-profile-images.mjs",
    "test:profile-storage": "node --import tsx --conditions=react-server scripts/rehearse-local-storage-adapter.ts",
    "test:shared-coach-picture": "node --import tsx --conditions=react-server scripts/rehearse-local-shared-coach-picture.ts",
    "test:coach-website-db": "node scripts/rehearse-coach-website-database.mjs",
    "test:coach-website": "node --import tsx --conditions=react-server scripts/rehearse-local-coach-website.ts",
    "test:coach-starting-rates-db": "node scripts/rehearse-coach-starting-rates-database.mjs",
    "test:coach-starting-rates": "node --import tsx --conditions=react-server scripts/rehearse-local-coach-starting-rates.ts",
    "test:e2e": "playwright test",
    "db:start": "supabase start --exclude gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "auth:start": "supabase start --exclude realtime,imgproxy,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "auth:status": "supabase status -o env | grep -E '^(API_URL|PUBLISHABLE_KEY|ANON_KEY)='",
    "auth:provision:test-user": "tsx scripts/provision-local-test-user.ts",
    "auth:provision:coaches": "tsx scripts/provision-local-coach-accounts.ts",
    "demo:setup:local": "node --import tsx scripts/provision-demo-coaches.ts --environment local",
    "demo:setup:dev": "node --import tsx scripts/provision-demo-coaches.ts --environment dev",
    "demo:urls:local": "node --import tsx scripts/provision-demo-coaches.ts --environment local --publish-urls",
    "demo:urls:dev": "node --import tsx scripts/provision-demo-coaches.ts --environment dev --publish-urls",
    "demo:retire:uat": "node --env-file=.env.development.local --import tsx scripts/retire-hosted-demo-coaches.ts --environment dev",
    "coach:review": "node --env-file-if-exists=.env.staging.local scripts/review-coach-application.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:runtime": "node scripts/prepare-local-runtime-database.mjs",
    "db:verify:hosted-runtime": "node scripts/verify-hosted-runtime-database.mjs",
    "db:seed": "node scripts/seed-local-database.mjs",
    "db:test": "supabase test db --local",
    "db:lint": "supabase db lint --local --schema app --fail-on warning",
    "format:check": "prettier --check scripts src tests playwright.config.ts package.json tsconfig.json postcss.config.mjs eslint.config.mjs vercel.json",
    "test:calendar-hosted": "node --env-file=.env.development.local scripts/rehearse-hosted-calendar-integration.mjs",
    "test:coach-public-urls-db": "node scripts/rehearse-coach-public-urls-database.mjs",
    "test:coach-public-urls": "node --import tsx --conditions=react-server scripts/rehearse-local-coach-public-urls.ts",
    "test:group-notifications-integration": "node scripts/rehearse-group-notifications-integration.mjs",
    "test:group-notifications-db": "node scripts/rehearse-group-notifications-database.mjs",
    "test:coach-application-emails-db": "node scripts/rehearse-coach-application-emails-database.mjs",
    "test:group-approvals-db": "node scripts/rehearse-group-approvals-database.mjs",
    "test:group-approvals-integration": "node scripts/rehearse-group-approvals-integration.mjs",
    "test:coach-media-db": "node scripts/rehearse-coach-media-database.mjs",
    "test:coach-media-integration": "node scripts/rehearse-coach-media-integration.mjs",
    "test:coach-media-live": "node scripts/rehearse-coach-media-live-mux.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@mux/mux-player-react": "3.14.1",
    "@mux/upchunk": "3.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.47.0",
    "maplibre-gl": "6.13.0",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.8",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "type": "module"
}
