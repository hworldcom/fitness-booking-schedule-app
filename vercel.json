{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build:vercel",
  "regions": ["fra1"],
  "crons": [
    { "path": "/api/internal/notifications/dispatch", "schedule": "* * * * *" },
    {
      "path": "/api/internal/google-calendar/dispatch",
      "schedule": "* * * * *"
    }
  ]
}
